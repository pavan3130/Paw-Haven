{
  "name": "paw-haven-adoption",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paw Haven - SAPUI5 and SAP CAP animal adoption demo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "watch:ui": "cds watch --open app/pawhaven/webapp/index.html?sap-ui-xx-viewCache=false",
    "install:all": "npm install --include=dev",
    "build:hana": "cds build --for hana",
    "deploy:cf": "cds up"
  },
  "dependencies": {
    "@sap/cds": "^10.2.1",
    "express": "^5.1.0",
    "@cap-js/hana": "^3.1.2",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin@example.com": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "pavan@example.com": {
              "password": "pavan",
              "roles": [
                "User"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
